{
  "name": "opencode-special-agents",
  "version": "0.1.0",
  "description": "Specialized AI agents and commands for OpenCode",
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@11.25.0",
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.29",
    "rolldown": "1.0.0"
  },
  "scripts": {
    "build": "pnpm exec rolldown -c && node scripts/verify-build.mjs",
    "gen:manifest": "node scripts/gen-manifest.mjs",
    "test:plugin": "bun test tests/continuation-state.test.ts",
    "test": "node --test tests/*.test.mjs && bun test tests/continuation-state.test.ts"
  }
}
